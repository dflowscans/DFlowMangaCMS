@model AdminDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

@if (ViewBag.DatabaseFixNeeded == true)
{
    <div class="db-fix-alert">
        <div class="alert-content">
            <h4><i class="fas fa-exclamation-triangle"></i> Database Maintenance Required</h4>
            <p>Some database tables or columns are missing. This might cause errors:</p>
            <ul>
                @if (ViewBag.ParentCommentIdMissing == true)
                {
                    <li>Missing <code>ParentCommentId</code> column in <code>ChapterComments</code> (required for replies).</li>
                }
                @if (ViewBag.SiteSettingsTableMissing == true)
                {
                    <li>Missing <code>SiteSettings</code> table (required for global site toggles).</li>
                }
                @if (ViewBag.NotificationsTableMissing == true)
                {
                    <li>Missing <code>Notifications</code> table (required for system alerts).</li>
                }
                @if (ViewBag.AniListIdMissing == true)
                {
                    <li>Missing <code>AniListId</code> column in <code>Mangas</code> table (required for AniList sync).</li>
                }
                @if (ViewBag.CustomizationColsMissing == true)
                {
                    <li>Missing <code>Customization</code> columns in <code>Users</code> table (required for user profile themes).</li>
                }
            </ul>
        </div>
        <form asp-action="FixDatabase" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-fix">Apply Fixes</button>
        </form>
    </div>
}

<!-- Stats Cards Grid -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon views"><i class="fas fa-eye"></i></div>
        <div class="stat-info">
            <h3>@Model.TotalViews.ToString("N0")</h3>
            <p>Total Views</p>
        </div>
        <div class="stat-trend positive">
            <i class="fas fa-arrow-up"></i> 12.5%
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon users"><i class="fas fa-users"></i></div>
        <div class="stat-info">
            <h3>@Model.TotalUsers.ToString("N0")</h3>
            <p>Total Users</p>
        </div>
        <div class="stat-trend positive">
            <i class="fas fa-arrow-up"></i> @Model.NewUsersLast7Days new
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon visitors"><i class="fas fa-user-check"></i></div>
        <div class="stat-info">
            <h3>@Model.UniqueVisitors.ToString("N0")</h3>
            <p>Unique Visitors</p>
        </div>
        <div class="stat-trend">
            Last 7 days
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon engagement"><i class="fas fa-chart-line"></i></div>
        <div class="stat-info">
            <h3>@Model.ActiveRate.ToString("F1")%</h3>
            <p>Active Rate</p>
        </div>
        <div class="stat-trend @(Model.ActiveRate > 50 ? "positive" : "")">
            @Model.UserEngagement.ToString("F1") views/user
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="charts-row">
    <div class="chart-container main-chart">
                    <div class="chart-header">
                        <h4>Traffic Trend</h4>
                    </div>
                    <div style="flex: 1; position: relative; min-height: 0;">
                        <canvas id="trafficChart"></canvas>
                    </div>
                </div>
                <div class="chart-container side-chart">
                    <div class="chart-header">
                        <h4>Device Distribution</h4>
                    </div>
                    <div style="flex: 1; position: relative; min-height: 0;">
                        <canvas id="deviceChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="charts-row">
                <div class="chart-container">
                    <div class="chart-header">
                        <h4>Popular Genres</h4>
                    </div>
                    <div style="flex: 1; position: relative; min-height: 0;">
                        <canvas id="genreChart"></canvas>
                    </div>
                </div>
                <div class="chart-container" style="height: auto; min-height: 400px;">
                    <div class="chart-header">
                        <h4>Popular Chapters</h4>
                    </div>
        <div class="popular-list">
            @foreach (var chapter in Model.PopularChapters)
            {
                <div class="popular-item">
                    <div class="item-info">
                        <span class="manga-title">@chapter.MangaTitle</span>
                        <span class="chapter-num">Chapter @chapter.ChapterNumber</span>
                    </div>
                    <div class="item-stats">
                        <span class="views-count">@chapter.Views.ToString("N0") views</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="activity-row">
    <div class="activity-card">
        <div class="card-header">
            <h4>Recent Manga</h4>
            <a href="@Url.Action("MangaList", "Admin")">View All</a>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Manga</th>
                        <th>Added</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var manga in Model.RecentManga)
                    {
                        <tr>
                            <td>
                                <div class="manga-cell">
                                    <img src="@manga.ImageUrl" alt="">
                                    <span>@manga.Title</span>
                                </div>
                            </td>
                            <td>@manga.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td><span class="status-badge @manga.Status.ToLower()">@manga.Status</span></td>
                            <td>
                                <a href="@Url.Action("EditManga", "Admin", new { id = manga.Id })" class="btn-icon"><i class="fas fa-edit"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const chartColors = {
            primary: '#6366f1',
            secondary: '#ec4899',
            success: '#10b981',
            info: '#0ea5e9',
            warning: '#f59e0b',
            muted: '#94a3b8'
        };

        // Traffic Chart
        const trafficCtx = document.getElementById('trafficChart').getContext('2d');
        new Chart(trafficCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.TrafficLabels)),
                datasets: [{
                    label: 'Views',
                    data: @Html.Raw(JsonSerializer.Serialize(Model.TrafficViews)),
                    borderColor: chartColors.primary,
                    backgroundColor: 'rgba(99, 102, 241, 0.1)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 3,
                    pointRadius: 4,
                    pointBackgroundColor: chartColors.primary
                }, {
                    label: 'Visitors',
                    data: @Html.Raw(JsonSerializer.Serialize(Model.TrafficVisitors)),
                    borderColor: chartColors.secondary,
                    backgroundColor: 'transparent',
                    fill: false,
                    tension: 0.4,
                    borderWidth: 3,
                    pointRadius: 4,
                    pointBackgroundColor: chartColors.secondary
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(255, 255, 255, 0.05)'
                        },
                        ticks: {
                            color: chartColors.muted
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: chartColors.muted
                        }
                    }
                }
            }
        });

        // Device Chart
        const deviceCtx = document.getElementById('deviceChart').getContext('2d');
        new Chart(deviceCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.DeviceLabels)),
                datasets: [{
                    data: @Html.Raw(JsonSerializer.Serialize(Model.DeviceCounts)),
                    backgroundColor: [chartColors.primary, chartColors.success, chartColors.warning],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: chartColors.muted,
                            padding: 20,
                            usePointStyle: true
                        }
                    }
                }
            }
        });

        // Genre Chart
        const genreCtx = document.getElementById('genreChart').getContext('2d');
        new Chart(genreCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(Model.GenreLabels)),
                datasets: [{
                    label: 'Manga Count',
                    data: @Html.Raw(JsonSerializer.Serialize(Model.GenreCounts)),
                    backgroundColor: chartColors.primary,
                    borderRadius: 8,
                    maxBarThickness: 40
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(255, 255, 255, 0.05)'
                        },
                        ticks: {
                            color: chartColors.muted
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: chartColors.muted
                        }
                    }
                }
            }
        });
    </script>
}
